{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Scenario Generator",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/tools/scenario/scenario_generator.py",
      "args": [
        "three_d_n_pts",
        "--outdir", "${workspaceFolder}/data/sitl_logs",
        "--runs", "1",
        "--start-run-id", "0",
        "--ardupilot-vehicle", "ArduCopter",
        "--ardupilot-frame", "gazebo-px4vision",
        "--ardupilot-model", "JSON",
        "--ardupilot-world", "default_fire_px4vision",
        "--ardupilot-location", "Purdue",
        "--px4-vehicle", "4006",
        "--px4-frame", "gz_fire_px4vision",
        "--px4-world", "default_fire",
        "--px4-location", "Purdue",
        "--n", "5",
        "--edge-m", "random", "--edge-m-range", "5", "20",
        "--vertex-deg", "random", "--vertex-deg-range", "0", "360",
        "--speed-m-s", "random", "--speed-m-s-range", "1", "20",
        "--alt-m", "random", "--alt-m-range", "2", "20",
        "--takeoff-alt-m", "10",
        "--landing-alt-m", "5",
        "--base-mass-scale", "random", "--base-mass-scale-range", "0.75", "1.25",
        "--base-inertia-scale", "random", "--base-inertia-scale-range", "0.85", "1.15",
        "--wind-horizontal-magnitude-m-s", "0",
        "--wind-horizontal-azimuth-deg", "0", 
        "--wind-vertical-magnitude-m-s", "0",
        "--wind-vertical-direction", "1",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug: PX4+Gazebo launcher",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "${workspaceFolder}/tools/launcher/run_px4_gz_sitl.py",
      "args": [
        "--run-root", "${workspaceFolder}/data/sitl_logs",
        "--startup-delay", "2",
        "--max-run-s", "300",
        "--verbose", // "--headless",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
